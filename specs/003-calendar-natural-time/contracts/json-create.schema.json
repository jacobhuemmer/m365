{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masonhuemmer/m365/specs/003-calendar-natural-time/contracts/json-create.schema.json",
  "title": "calendar create JSON (phrase)",
  "type": "object",
  "required": ["start", "end"],
  "properties": {
    "id": { "type": "string" },
    "dry_run": { "type": "boolean" },
    "when": { "type": "string" },
    "subject": { "type": "string" },
    "start": { "type": "string" },
    "end": { "type": "string" },
    "timezone": { "type": "string" }
  }
}
