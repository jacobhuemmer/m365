{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masonhuemmer/m365/contracts/json-error.schema.json",
  "title": "m365 stderr error object",
  "type": "object",
  "additionalProperties": false,
  "required": ["class", "message"],
  "properties": {
    "class": {
      "type": "string",
      "enum": ["usage", "auth", "service", "not_found"]
    },
    "message": { "type": "string", "minLength": 1 },
    "hint": { "type": "string" }
  },
  "description": "Exactly one JSON object on stderr for failures in JSON mode. MUST NOT contain tokens, secrets, or file bytes."
}
